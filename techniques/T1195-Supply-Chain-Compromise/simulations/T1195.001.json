{
  "id": "T1195.001",
  "title": "Dependency poisoning: the long game",
  "subtitle": "A patient contributor becomes a maintainer, poisons a release, and lets the build pipeline pull it in automatically.",
  "aria": "Animated dependency poisoning: an attacker earns maintainer trust, publishes a poisoned package, a consumer CI pipeline installs it, the backdoor ships in a product, a researcher reports it, and the release is rolled back.",
  "zones": [
    {
      "label": "Open-source upstream",
      "x": 2,
      "y": 4,
      "w": 46,
      "h": 64,
      "color": "#a78bfa"
    },
    {
      "label": "Your build and product",
      "x": 52,
      "y": 4,
      "w": 46,
      "h": 64,
      "color": "#4f8cff"
    }
  ],
  "nodes": [
    {
