    },
    {
      "id": "ci",
      "x": 31,
      "y": 38,
      "w": 24,
      "h": 10,
      "kind": "ci",
      "label": "CONSUMER CI",
      "sub": "Build runner",
      "tip": "Your build runner. It resolves dependencies from the lockfile and registry."
    },
    {
      "id": "build",
      "x": 31,
      "y": 53,
      "w": 24,
      "h": 10,
      "kind": "artifact",
      "label": "BUILD OUTPUT",
      "sub": "Product binary",
      "tip": "The product that links the dependency and inherits the hidden change."
    },
    {
      "id": "researcher",
      "x": 64,
      "y": 62,
      "w": 20,
      "h": 11,
      "kind": "researcher",
