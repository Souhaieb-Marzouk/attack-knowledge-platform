      "x": 4,
      "y": 8,
      "w": 14,
      "h": 10,
      "kind": "attacker",
      "label": "CONTRIBUTOR",
      "sub": "New identity",
      "tip": "A new contributor who spends months making useful, low-risk changes."
    },
    {
      "id": "oss",
      "x": 31,
      "y": 8,
      "w": 24,
      "h": 10,
      "kind": "repo",
      "label": "OSS PROJECT",
