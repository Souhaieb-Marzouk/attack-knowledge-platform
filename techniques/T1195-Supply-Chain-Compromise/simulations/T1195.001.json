      "w": 20,
      "h": 11,
      "kind": "soc",
      "label": "SOC",
      "sub": "Hunt + response",
      "tip": "The security team that turns the public report into a hunt and rollback."
    }
  ],
  "flows": [
    {
      "id": "f1",
      "from": "atk",
      "to": "oss",
      "color": "danger",
      "bend": -2
    },
    {
      "id": "f2",
      "from": "oss",
      "to": "registry",
      "color": "violet",
      "bend": 2
    },
    {
      "id": "f3",
      "from": "registry",
      "to": "ci",
      "color": "warn",
      "bend": -4
    },
    {
      "id": "f4",
      "from": "ci",
      "to": "build",
      "color": "accent2",
      "bend": 2
    },
    {
      "id": "f5",
      "from": "build",
      "to": "researcher",
      "color": "violet",
      "bend": -6
    },
    {
      "id": "f6",
      "from": "researcher",
      "to": "soc",
      "color": "success",
      "bend": 4
    },
    {
      "id": "f7",
      "from": "soc",
      "to": "registry",
      "color": "success",
      "bend": 20
    }
  ],
  "steps": [
    {
      "title": "Become useful",
      "caption": "The attacker creates a friendly contributor identity and sends small, genuinely useful fixes for months. Reputation is the payload.",
      "defender": "",
      "nodes": {
        "atk": "active",
        "oss": "watch"
      },
      "activeFlows": [
        "f1"
      ],
      "packets": [
        {
          "from": "atk",
          "to": "oss",
          "label": "pull request",
          "at": 0.2,
          "duration": 2.2
        }
      ],
      "logs": [
        {
          "source": "Git forge",
          "event": "pull_request.opened",
          "fields": {
            "repo": "liblzma",
            "actor": "helper-2024",
            "files": 2,
            "review": "approved"
          }
        }
      ],
      "detection": {
        "state": "none",
        "label": "Public community",
        "detail": "There is nothing in your environment to detect yet."
      }
    },
    {
      "title": "Earn release rights",
      "caption": "The overworked lead maintainer gives the new contributor commit and release permissions. The project now trusts the attacker.",
      "defender": "",
      "nodes": {
        "atk": "active",
        "oss": "comp"
      },
      "activeFlows": [
        "f1"
      ],
      "packets": [
        {
          "from": "atk",
          "to": "oss",
          "label": "maintainer role",
          "at": 0.5,
          "duration": 2
        }
      ],
      "logs": [
        {
          "source": "Git forge",
          "event": "member.role_changed",
          "fields": {
            "repo": "liblzma",
            "actor": "helper-2024",
            "role": "maintainer",
            "by": "lead-maintainer"
          }
        }
      ],
      "detection": {
        "state": "none",
        "label": "Upstream audit only",
        "detail": "The forge logs the role change, but the customer does not consume that feed."
      }
    },
    {
      "title": "Publish a poisoned release",
      "caption": "The new release contains a loader hidden in test data. It activates only in specific build products, so casual review and fuzzing miss it.",
      "defender": "",
      "nodes": {
        "atk": "done",
        "oss": "comp",
        "registry": "comp"
      },
      "activeFlows": [
        "f2"
      ],
      "packets": [
        {
          "from": "oss",
          "to": "registry",
          "label": "release 5.6.1",
          "at": 0.4,
          "duration": 2.2
        }
      ],
      "logs": [
        {
          "source": "Registry",
          "event": "package.published",
          "fields": {
            "name": "liblzma",
            "version": "5.6.1",
            "publisher": "helper-2024",
            "sha256": "c1f0...8bd2"
          }
        },
        {
          "source": "Git forge",
          "event": "tag.created",
          "fields": {
            "tag": "v5.6.1",
            "commit": "a1b2c3d",
            "signature": "none"
          }
        }
      ],
      "detection": {
        "state": "none",
        "label": "Routine release",
        "detail": "A new version is normal. The package name and publisher are correct."
      }
    },
    {
      "title": "CI pulls the release",
      "caption": "Your build runner sees that 5.6.1 satisfies its dependency range, downloads the tarball, and installs it without a human review.",
      "defender": "",
      "nodes": {
        "registry": "comp",
        "ci": "active"
      },
      "activeFlows": [
        "f3"
      ],
      "packets": [
        {
          "from": "registry",
          "to": "ci",
          "label": "tarball download",
          "at": 0.3,
          "duration": 2.2
        }
      ],
      "logs": [
        {
          "source": "Package manager",
          "event": "dependency.resolved",
          "fields": {
            "package": "liblzma",
            "requested": ">=5.6.0",
            "selected": "5.6.1",
            "lockfile": "updated"
          }
        },
        {
          "source": "CI runner",
          "event": "step.completed",
          "fields": {
            "job": "build-product",
            "command": "npm ci",
            "runner": "ubuntu-24.04",
            "duration": "02:14"
          }
        }
      ],
      "detection": {
        "state": "partial",
        "label": "Only a version bump",
        "detail": "A package download is normal. The source and destination are both expected."
      }
    },
    {
      "title": "Build the backdoor in",
      "caption": "During linking, the injected test data changes a security-critical binary. The product's tests pass because it behaves normally.",
      "defender": "",
      "nodes": {
        "ci": "comp",
        "build": "comp"
      },
      "activeFlows": [
        "f4"
      ],
      "packets": [
        {
          "from": "ci",
          "to": "build",
          "label": "compile + link",
          "at": 0.3,
          "duration": 2.3
        }
      ],
      "logs": [
        {
          "source": "Build log",
          "event": "link.completed",
          "fields": {
            "artifact": "product-4.8.1",
            "dependency": "liblzma-5.6.1",
            "tests": "passed"
          }
        },
        {
          "source": "Artifact repository",
          "event": "artifact.pushed",
          "fields": {
            "name": "product-4.8.1.tar.gz",
            "signer": "release-bot",
            "size": "48.2 MB"
          }
        }
      ],
      "detection": {
        "state": "none",
        "label": "Tests are green",
        "detail": "No test covers the hidden build-time behavior."
      }
    },
    {
      "title": "Ship it to production",
      "caption": "The product is deployed to production. The backdoor waits for a trigger and looks like a normal part of the service.",
      "defender": "",
      "nodes": {
        "build": "comp",
        "researcher": "watch",
        "soc": "watch"
      },
      "activeFlows": [
        "f5"
      ],
      "packets": [
        {
          "from": "build",
          "to": "researcher",
          "label": "product deploy",
          "at": 0.4,
          "duration": 2.1
        }
      ],
      "logs": [
        {
          "source": "Deployment",
          "event": "release.deployed",
          "fields": {
            "service": "portal",
            "version": "4.8.1",
            "hosts": 240,
            "change": "CHG-8821"
          }
        },
        {
          "source": "APM",
          "event": "latency.baseline",
          "fields": {
            "service": "auth",
            "p95": "180ms",
            "baseline": "120ms"
          }
        }
      ],
      "detection": {
        "state": "none",
        "label": "Normal deploy",
        "detail": "The deployment follows the normal path; the latency change is small."
      }
    },
    {
      "title": "A researcher notices",
      "caption": "A developer debugging a slow login finds an unexplained delay and memory anomaly. They trace it to the new dependency and report it publicly.",
      "defender": "The external report gives the SOC a version, hash, and behavioral clue.",
      "nodes": {
        "researcher": "active",
        "soc": "active",
        "build": "alert"
      },
      "activeFlows": [
        "f5",
        "f6"
      ],
      "packets": [
        {
          "from": "researcher",
          "to": "soc",
          "label": "report + hashes",
          "at": 0.2,
          "duration": 2
        }
      ],
      "logs": [
        {
          "source": "Issue tracker",
          "event": "security.report",
          "fields": {
            "package": "liblzma",
            "version": "5.6.1",
            "symptom": "sshd latency",
            "reporter": "researcher"
          }
        },
        {
          "source": "SIEM",
          "event": "hunt.started",
          "fields": {
            "query": "process has liblzma 5.6.1",
            "scope": "prod + build",
            "analyst": "soc-tier2"
          }
        }
      ],
      "detection": {
        "state": "alert",
        "label": "External signal -> hunt",
        "detail": "The SOC starts from the dependency version and looks for affected hosts."
      }
    },
    {
      "title": "Rollback and provenance",
      "caption": "The team pins the previous version, rebuilds, rotates credentials from affected runners, and requires provenance attestation for future builds.",
      "defender": "Containment: pin, rebuild, rotate build secrets, verify artifact provenance.",
      "nodes": {
        "soc": "done",
        "build": "done",
        "researcher": "done",
        "registry": "watch"
      },
      "activeFlows": [
        "f7"
      ],
      "packets": [
        {
          "from": "soc",
          "to": "registry",
          "label": "pin + report",
          "at": 0.3,
          "duration": 2
        }
      ],
      "logs": [
        {
          "source": "Dependency policy",
          "event": "version.pinned",
          "fields": {
            "package": "liblzma",
            "version": "5.6.0",
            "scope": "all build images"
          }
        },
        {
          "source": "CI",
          "event": "credentials.rotated",
          "fields": {
            "runner_pool": "build-linux",
            "secrets": 14,
            "status": "complete"
          }
        },
        {
          "source": "Registry",
          "event": "package.deprecated",
          "fields": {
            "package": "liblzma",
            "version": "5.6.1",
            "reason": "security"
          }
        }
      ],
      "detection": {
        "state": "clear",
        "label": "Contained",
        "detail": "The poisoned version is blocked and build credentials are rotated."
      }
    }
  ],
  "renderer": "pipeline",
  "theme": "violet"
}
