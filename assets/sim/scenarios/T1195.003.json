      "x": 5,
      "y": 44,
      "w": 14,
      "h": 11,
      "kind": "attacker",
      "label": "ATTACKER",
      "sub": "Interdiction team",
      "tip": "An actor with access to the shipping path, not the factory itself."
    },
    {
      "id": "factory",
      "x": 6,
      "y": 9,
      "w": 14,
      "h": 11,
      "kind": "factory",
      "label": "FACTORY",
