      "h": 11,
      "kind": "transit",
      "label": "IN TRANSIT",
      "sub": "Carrier hub",
      "tip": "A shipping or storage point where the package can be opened and resealed."
    },
    {
      "id": "depot",
      "x": 48,
      "y": 9,
      "w": 14,
      "h": 11,
      "kind": "transit",
      "label": "RECEIVING",
      "sub": "Customer dock",
      "tip": "The customer receiving dock. The tampered package arrives with a plausible seal."
    },
    {
      "id": "device",
      "x": 69,
      "y": 22,
      "w": 16,
      "h": 11,
      "kind": "device",
      "label": "EDGE APPLIANCE",
      "sub": "Installed",
      "tip": "The appliance is racked and configured normally. The implant is on the board."
    },
    {
      "id": "c2",
