{
  "id": "T1195.003",
  "title": "Hardware interdiction: the appliance that arrived changed",
  "subtitle": "A network appliance is intercepted in transit, a tiny implant is added, and the device behaves normally until it checks in months later.",
  "aria": "Animated hardware supply chain attack: an appliance is intercepted in transit, an implant is added, the tampered device is delivered and installed, then beacons to an attacker and is found by the SOC.",
  "zones": [
    {
      "label": "Factory and transit",
      "x": 2,
      "y": 4,
      "w": 46,
      "h": 64,
      "color": "#fbbf24"
    },
    {
      "label": "Customer site",
      "x": 52,
      "y": 4,
      "w": 46,
      "h": 64,
      "color": "#34d399"
    }
  ],
  "nodes": [
