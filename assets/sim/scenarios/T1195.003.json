      "tip": "The customer SOC, watching network flows and configuration changes."
    }
  ],
  "flows": [
    {
      "id": "f1",
      "from": "factory",
      "to": "transit",
      "color": "warn",
      "bend": 3
    },
    {
      "id": "f2",
      "from": "atk",
      "to": "transit",
      "color": "danger",
      "bend": -2
    },
    {
      "id": "f3",
      "from": "transit",
      "to": "depot",
      "color": "warn",
      "bend": -4
    },
    {
      "id": "f4",
      "from": "depot",
      "to": "device",
      "color": "accent2",
      "bend": 3
    },
    {
      "id": "f5",
      "from": "device",
      "to": "c2",
      "color": "danger",
      "bend": 8
